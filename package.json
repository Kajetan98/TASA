{
  "name": "tasa-monitor",
  "private": true,
  "version": "0.1.0",
  "description": "Monitorowanie stanu, działania i aktywacji kotwicy TASA (Tensinigryt) oraz stacji uzbrajania",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:standalone": "npm run build && cp dist/index.html TASA_Monitor.html"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uplot": "^1.6.32",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/w3c-web-serial": "^1.0.9",
    "@types/web-bluetooth": "^0.0.22",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
